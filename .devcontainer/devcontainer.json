{
  "name": "rola-dev",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      // Stamped into `tools/ratify.py`'s `source.image_digest` (K37) by every
      // ratification run inside this container. `${localEnv:...}` so it is
      // supplied by whoever builds the image (a CI runner, a developer's own
      // `docker build`), never hard-coded here -- see docs/setup.md for how to
      // compute it (`sha256sum Dockerfile`).
      "ROLA_IMAGE_DIGEST": "${localEnv:ROLA_IMAGE_DIGEST}"
    }
  },
  // GPU passthrough. `--gpus all` is the WSL2/nvidia-container-toolkit path
  // docs/setup.md walks through; `hostRequirements.gpu` is the portable
  // (non-Docker-Desktop-specific) declaration some devcontainer front ends
  // read instead of `runArgs`.
  "runArgs": [
    "--gpus=all",
    "--ipc=host"
  ],
  "hostRequirements": {
    "gpu": true
  },
  // WORKTREES MOUNT -- GENUINELY OPTIONAL (fix 2026-08-29, a question of
  // Blake's exposed this): the clone IS the workspace; a contributor who has
  // never heard of "worktrees" must be able to clone, open, and have it
  // just work, with no directory to create first.
  //
  // WHAT WAS WRONG: the previous form used the OBJECT mount syntax
  // (`source=...,type=bind`) with a REPO-RELATIVE PATH default
  // (`${localWorkspaceFolder}/../worktrees`). Reproduced with the real
  // `@devcontainers/cli up` (0.88.0) against a genuine fresh clone with
  // `ROLA_WORKTREES_DIR` unset: the object-form bind mount's default resolved
  // to a `../worktrees` path that does not exist next to a fresh clone, and
  // the devcontainer tooling's own pre-flight handling of that entry is what
  // this repo's contributor hit -- not necessarily raw `dockerd`, whose exact
  // missing-bind-source behavior varies by version/backend and was NOT the
  // thing gated on here.
  //
  // THE FIX avoids the question entirely rather than depending on which
  // layer would have refused: it exploits Docker's OWN two mount syntaxes.
  // The classic `-v SOURCE:TARGET` shorthand (a plain string here, which the
  // devcontainer spec passes through as-is, unlike the object `type=bind`
  // form) decides bind-vs-volume from the SHAPE of `SOURCE`: a bare name
  // with no path separators is a NAMED VOLUME, which Docker auto-creates
  // empty with no pre-existing host resource required (verified: `docker run
  // --rm -v rola-worktrees-test:/x busybox true` succeeds with no prior
  // `docker volume create`) -- so there is no missing-source question to
  // answer for the zero-config case at all, on any backend.
  // `${localEnv:ROLA_WORKTREES_DIR:rola-worktrees}` resolves to the bare name
  // `rola-worktrees` (a named volume, zero-config) when the variable is
  // UNSET, and to whatever host PATH a developer exports (bind-mounted) when
  // it IS set -- ONE declarative line, no conditional the JSON format could
  // not express, exactly mirrored in `docs/setup.md`'s plain `docker run`
  // line via bash's own `${VAR:-default}`.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/rola,type=bind,consistency=cached",
  "workspaceFolder": "/workspace/rola",
  "mounts": [
    "${localEnv:ROLA_WORKTREES_DIR:rola-worktrees}:/workspace/worktrees"
  ],
  "remoteEnv": {
    "ROLA_IMAGE_DIGEST": "${localEnv:ROLA_IMAGE_DIGEST}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-python.python",
        "charliermarsh.ruff",
        "nvidia.nsight-vscode-edition"
      ],
      "settings": {
        "clangd.path": "/usr/local/bin/clangd",
        "python.defaultInterpreterPath": "/opt/venv/bin/python3"
      }
    }
  },
  // The image already carries the venv (`/opt/venv`, built from
  // `requirements.lock`) and every apt/pinned-release tool; nothing further
  // to install post-create. The FIRST build of the SHIPPED set and the
  // battery are run by hand once (docs/setup.md), not on every container
  // start, because they are multi-minute and the compile cache
  // (`/workspace/rola/build/temp`) already persists across restarts via the
  // bind mount above.
  "postCreateCommand": "python3 --version && nvcc --version && ptxas --version"
}
