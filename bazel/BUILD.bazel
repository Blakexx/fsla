"""THE GRAPH'S OWN MACHINERY: the target platform, the environment's builder, the flag emitter, the header generator
and the record writer, the CUDA runtime's headers, and the sources their actions read (docs/build-graph.md)."""

load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load(":defs.bzl", "cuda_root", "tree_part")

package(default_visibility = ["//visibility:public"])

#: the one target platform the graph builds for, the platform the C++ toolchain resolves for
platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

#: THE CUDA RUNTIME'S HEADERS, without its libraries: the units' runtime (the library links the runtime itself), the pinned
#: toolkit's `include/` and CCCL's `include/cccl`, the roots an installed toolkit's nvcc.profile adds
alias(
    name = "cuda_headers",
    actual = "@cuda_tools//:cuda_headers",
)

#: the architectures the graph's CUDA units compile for, as the compile's specs (`compute_90a:sm_90a`, `;` between); the library's
#: transition writes it from `--//:archs`, a unit's `archs` overrides it
string_flag(
    name = "cuda_archs",
    build_setting_default = "",
)

#: the CUDA root clang's front end reads, for the unit lints and the editor
cuda_root(
    name = "cuda_root",
    cudart = ":cuda_headers",
    curand = "@cuda_tools//:curand_headers",
)

exports_files([
    "cuda_compile.py",
    "arm_emit.py",
    "arms.py",
    "flags.py",
    "gates.py",
    "headers.py",
    "record.py",
])

#: what the SASS gate reads: the tree's tools (the gate and the modules it imports) and every kernel the source defines
#: (a kernel no cubin carries is red)
filegroup(
    name = "gate_sources",
    srcs = [
        "//csrc/fsla:sources",
        "//tools:python_sources",
    ],
)

#: what the header action, the arm gate and the record read: the arm helpers and the registry
filegroup(
    name = "generator_sources",
    srcs = [
        "//:measure/__init__.py",
        "//bazel:arms.py",
        "//hardware:registry",
    ],
)

#: what the build gates and the record read: the toolchain records, the vendored tree, the version
filegroup(
    name = "record_sources",
    srcs = [
        "//:fsla/__init__.py",
        "//csrc/fsla:sources",
        "//csrc/third_party:cutlass_tree",
        "//tools:build_record.py",
        "//tools:toolchain_records",
        "//tools:toolchains.py",
    ],
)

#: this package's part of the tree the checks read
tree_part()
