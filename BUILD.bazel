"""THE ROOT PACKAGE: the build's parameters and the extension (docs/build-graph.md#compile).

    bazel build //:library                      # fsla_cu13/_C.abi3.so and its build record, the shipped build, in .bazel/bin
    bazel run //:library                        # the same, with the build's generated headers in build/generated
    bazel run //:library --//:archs=90a --//:contract=decode_d32_l2    # an iteration build
    bazel run //:readme_update                  # write the README's generated block (and //:devbox_image_update: docs/build-graph.md#committed-files)
    bazel run //:ratify -- --census             # every shipped instantiation's registers and spills (docs/ratification.md)
"""

load("@bazel_skylib//rules:common_settings.bzl", "string_flag", "string_list_flag")
load("@fsla_env//:flags.bzl", "BUILT_ARCHS", "CXX11_ABI", "TOOLCHAIN", "TORCH", "TORCH_CUDA", "VENV")
load("//bazel:arms.bzl", "ARM_FAMILIES")
load("//bazel:defs.bzl", "census_test", "checkout_test", "committed_file", "compile_database", "dev_run", "docrefs_test", "full_contract_test", "lock_update", "ratify_census", "ratify_run", "fsla_extension", "fsla_instrument", "fsla_wheels", "tool_run", "tool_test", "tree_part", "tree_test")
load("@fsla_devtools//bazel:rules.bzl", "bazel_version_test")
load("@fsla_tree//:tree.bzl", "TRACKED")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@tar.bzl", "tar")

exports_files([
    ".clang-format",
    ".clang-tidy",
    "MODULE.bazel",
    "requirements.lock",
    "sgconfig.yml",
    "fsla/__init__.py",
    "docs/rules.json",
])

#: THE BUILD'S PARAMETERS. The defaults are the shipped build: every built architecture, every arm, every part; any
#: other value is an iteration build, which its record says.
string_list_flag(
    name = "archs",
    build_setting_default = BUILT_ARCHS,
    visibility = ["//visibility:public"],
)

#: THE CONTRACT the build compiles against: `full` (the default, what the gate and releases require) or a declared NARROWED contract of
#: `hardware/kernels/<kernel>/descriptors/dev/` (a development build's subset: `arms_gen` compiles the arms it reaches, the run time refuses a call outside it)
string_flag(
    name = "contract",
    build_setting_default = "full",
    visibility = ["//visibility:public"],
)

fsla_extension(
    name = "library",
    cxx11_abi = CXX11_ABI,
    toolchain = TOOLCHAIN,
    torch = TORCH,
    torch_cuda = TORCH_CUDA,
    shared_libraries = ["@fsla_env//:torch_libraries"],
    #: the unit lints read the units it links; the test tiers import it; a timing entry's bundle carries it
    visibility = [
        "//csrc/fsla:__pkg__",
        "//measure:__pkg__",
        "//tests:__pkg__",
    ],
    deps = [
        "//csrc/fsla:%s_declarations" % family
        for family in ARM_FAMILIES
    ] + [
        "//csrc/fsla:registration",
        "//csrc/fsla:runtime",
        "//csrc/fsla:stamp_unit",
        "//csrc/fsla:units",
    ],
)

#: the `fsla` package and the plugin package's source half (`fsla_cu13/__init__.py`; the library is its built half), as
#: a timing entry's bundle carries them (`//measure:bundle`)
filegroup(
    name = "package",
    srcs = glob(
        ["fsla/**"],
        exclude = ["**/.gitkeep"],
    ) + ["fsla_cu13/__init__.py"],
    visibility = ["//measure:__pkg__"],
)

#: THE STATIC MANIFEST of the library, one file a built architecture (`fsla_cu13/sass_gate.<arch>.manifest.json`): warpline's, the build output
#: the SASS gate's comparison judged, what each rule found and the figures of every kernel (docs/internals/tools/sass_gate.md#manifest)
filegroup(
    name = "static_manifest",
    srcs = [":library"],
    output_group = "manifest",
    visibility = ["//measure:__subpackages__"],
)

#: THE MACHINE'S SETUP AS RUN TARGETS: each a tools/dev.py command, its arguments after `--` (docs/build-graph.md#use)
[dev_run(
    name = name,
    command = [command],
) for name, command in [
    ("init", "init"),
    ("check", "check"),
    ("clock", "clock"),
    ("show", "show"),
    ("get", "get"),
    ("worktree", "worktree"),
]]

#: THE ENVIRONMENT'S LOCK (docs/build-graph.md#environment): `bazel run //:lock_update` compiles requirements.in into
#: requirements.lock with the pinned uv
lock_update(name = "lock_update")

#: THE CHECKOUT'S VENV over the graph's environment, which its commit hooks then run from (docs/build-graph.md#use)
dev_run(
    name = "dev_env",
    checkout = True,
    command = ["dev-env"],
    env = True,
    tools = {
        "@fsla_env//:python": "--python",
        "@uv//:uv": "--uv",
    },
)

#: THE CENSUS: the units' own compiles (docs/ratification.md), reported by `bazel run //:ratify -- --census`
ratify_census(
    name = "census",
    library = ":library",
    #: the template lint reads the units the library compiled
    visibility = ["//csrc/fsla:__pkg__"],
)

#: THE COMMITTED FILES THE GRAPH WRITES (docs/build-graph.md#committed-files): each a test that the committed file is what
#: the graph's action writes, and a `bazel run //:<name>_update` that writes it. The README's and docs/support.md's generated blocks (`tools/supported.py`, from the contract in `hardware/`); the devbox image's digest
#: (docs/setup.md#the-devbox-image)
#: the environment's interpreter by its store path (which carries the environment's key), which the sandbox does not hold
genrule(
    name = "readme_generated",
    srcs = [
        "README.md",
        "//hardware:registry",
        "//tools:toolchain_records",
        "//tools:toolchains.py",
    ],
    outs = ["readme/README.md"],
    cmd = VENV + "/bin/python3 $(execpath //tools:supported.py) --readme $(execpath README.md) --out $@",
    tags = ["no-sandbox"],
    tools = ["//tools:supported.py"],
)

committed_file(
    name = "readme",
    committed = "README.md",
    generated = ":readme_generated",
)

#: docs/support.md's block: the contract, a kernel a table, every fact
genrule(
    name = "support_generated",
    srcs = [
        "docs/support.md",
        "//hardware:registry",
        "//tools:toolchain_records",
        "//tools:toolchains.py",
    ],
    outs = ["support/support.md"],
    cmd = VENV + "/bin/python3 $(execpath //tools:supported.py) --readme $(execpath docs/support.md) --out $@",
    tags = ["no-sandbox"],
    tools = ["//tools:supported.py"],
)

committed_file(
    name = "support",
    committed = "docs/support.md",
    generated = ":support_generated",
)

genrule(
    name = "devbox_image_record",
    srcs = [":image"],
    outs = ["devbox_image/devbox_image.json"],
    cmd = "$(execpath @fsla_env//:python) $(execpath //tools:oci_layout.py) --record $(execpath :image) > $@",
    tools = [
        "//tools:oci_layout.py",
        "@fsla_env//:python",
    ],
)

committed_file(
    name = "devbox_image",
    committed = "//tools:devbox_image.json",
    generated = ":devbox_image_record",
)

#: THE WHEELS (docs/build.md#wheels): `fsla` and its plugin `fsla-cu13` from this library, on a clean commit;
#: `bazel run //:wheels` writes dist/
fsla_wheels(
    name = "wheels",
    library = ":library",
)

#: THE MEASUREMENTS' RECORD (docs/measurement.md): the store's own command line, in the checkout on its own venv
tool_run(
    name = "results",
    module = "fsla_devtools.results",
)

#: the content checks over a staged diff or a pushed range (`--staged`, `--range A..B`): the pre-commit and pre-push
#: hooks run it, so a line a public repository must not carry never enters history (docs/build-graph.md#checks)
tool_run(
    name = "tripwire",
    environment = True,
    module = "fsla_devtools.tripwire",
)

ratify_run(
    name = "ratify",
    census = ":census",
)

#: THE DEVBOX IMAGE, a thin wrapper around the bootstrap: what a host supplies itself before the graph, nothing the graph
#: or the bootstrap installs -- see docs/setup.md#the-devbox-image. The packages' commands under the names their
#: alternatives give them, which a layer of files cannot run
tar(
    name = "devbox_links",
    mtree = [
        "usr/local/bin uid=0 gid=0 mode=0755 time=0 type=dir",
        "usr/local/bin/vim uid=0 gid=0 mode=0777 time=0 type=link link=/usr/bin/vim.nox",
        "usr/local/bin/vi uid=0 gid=0 mode=0777 time=0 type=link link=/usr/bin/vim.nox",
        "usr/local/bin/ctags uid=0 gid=0 mode=0777 time=0 type=link link=/usr/bin/ctags-universal",
        "usr/local/bin/fd uid=0 gid=0 mode=0777 time=0 type=link link=/usr/bin/fdfind",
        "usr/local/bin/clang-query uid=0 gid=0 mode=0777 time=0 type=link link=/usr/bin/clang-query-14",
    ],
)

#: the packages as one layer for the base's merged /usr: what they ship under /bin, /lib, /lib64 or /sbin goes under
#: /usr, as dpkg writes it through the base's links, which a layer's directories there would replace
genrule(
    name = "devbox_debs",
    srcs = [
        "@devbox//:flat",
        "@devbox_base_linux_amd64",
    ],
    outs = ["devbox_debs.tar"],
    cmd = "$(execpath @fsla_env//:python) $(execpath //tools:usrmerge_layer.py) --base $(execpath @devbox_base_linux_amd64) " +
          "--in $(execpath @devbox//:flat) --out $@",
    tools = [
        "//tools:oci_layout.py",
        "//tools:usrmerge_layer.py",
        "@fsla_env//:python",
    ],
)

oci_image(
    name = "image",
    base = "@devbox_base",
    cmd = ["/bin/bash"],
    env = {
        #: under WSL the driver's Linux libraries are mounted at /usr/lib/wsl/lib, which the loader must search first
        "LD_LIBRARY_PATH": "/usr/lib/wsl/lib",
        #: the bootstrap links `bazel` in ~/.local/bin (`toolchain.bazel`), first on PATH as on a host
        "PATH": "/root/.local/bin:${PATH}",
    },
    tars = [
        ":devbox_debs",
        ":devbox_links",
    ],
    workdir = "/workspace",
)

#: the package layer adds packages and never changes the base's: each package the base has is at the base's version
tool_test(
    name = "devbox_packages",
    size = "small",
    args_ = [
        "--base",
        "$(rootpath @devbox_base_linux_amd64)",
        "--layer",
        "$(rootpath :devbox_debs)",
        "$(rootpaths @devbox//:packages)",
    ],
    data = [
        ":devbox_debs",
        "@devbox//:packages",
        "@devbox_base_linux_amd64",
        "//tools:oci_layout.py",
        "//tools:usrmerge_layer.py",
    ],
    tool = "//tools:devbox_packages.py",
)

#: `bazel run //:image_load` hands the image to Docker, which only runs it
oci_load(
    name = "image_load",
    image = ":image",
    repo_tags = ["fsla-devbox:latest"],
)

#: `bazel run //:image_push` publishes the image to Docker Hub (`blakeresearch/fsla-devbox`, public like the namespace's
#: other images), where a rented box pulls it by the digest the tree names; tagged by the digest's first 12 digits
genrule(
    name = "image_tag",
    srcs = [":image"],
    outs = ["image_tag.txt"],
    cmd = "$(execpath @fsla_env//:python) $(execpath //tools:oci_layout.py) --tag $(execpath :image) > $@",
    tools = [
        "//tools:oci_layout.py",
        "@fsla_env//:python",
    ],
)

oci_push(
    name = "image_push",
    image = ":image",
    remote_tags = ":image_tag",
    repository = "index.docker.io/blakeresearch/fsla-devbox",
)

#: the image as Docker loads it, which the container commands hand it
filegroup(
    name = "image_tarball",
    srcs = [":image_load"],
    output_group = "tarball",
)

#: THE CONTAINER (docs/setup.md#the-devbox-image): the clean room, the host's loop run inside the image on fresh
#: volumes of its own and recorded under the image's digest; and an editor's dev container on the devbox's volumes
[dev_run(
    name = name,
    command = ["container", action],
    tools = {
        ":image": "--layout",
        ":image_tarball": "--tarball",
    },
) for name, action in [
    ("container_check", "check"),
    ("container_compose", "compose"),
]]

#: THE TREE: every tracked file, each package's part (`git ls-files`, @fsla_tree), as the checks read it; and its
#: Python files
tree_part()

filegroup(
    name = "tree",
    srcs = ["//%s:tracked" % package for package in TRACKED],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "tree_python",
    srcs = ["//%s:tracked_python" % package for package in TRACKED],
    visibility = ["//visibility:public"],
)

#: THE EDITOR'S COMPILE DATABASE: `bazel build //:compile_commands` is .bazel/bin/compile_commands.json, each unit's clang
#: command for the first ratified architecture, which the tracked `.clangd` names (docs/build-graph.md#checks)
compile_database(
    name = "compile_commands",
    units = [":library"],
)

#: THE REPO'S CHECKS (docs/build-graph.md#checks): the policies over the whole tree -- the Python's lints, the
#: standards, the agent files and the declarations, each ratchet against its baseline -- and the checks of the commit, run in
#: the checkout: what git knows

tree_test(
    name = "ruff",
    size = "small",
    cmd = ["ruff", "check", "--force-exclude", "."],
    data = [":pyproject.toml", ":tree_python"],
)

tree_test(
    name = "ruff_e3",
    size = "small",
    cmd = ["tools/lint/run_ruff_e3.sh"],
    data = [
        "//tools/lint:tracked",
        ":pyproject.toml",
        ":tree_python",
    ],
)

tree_test(
    name = "lint_standards",
    size = "small",
    cmd = ["python3", "tools/lint/lint_standards.py"],
    data = [":tree"],
    git = True,
    #: the rates' check reads the lab records the measured rates name, in the pinned data
    repos = {"@fsla_data//:records": "FSLA_DATA"},
)

#: THE GRAPH RUNS THE TOOLCHAIN (KERNEL_STANDARDS#s14-graph): no tracked code runs a toolkit tool, a build tool, an install or a
#: pytest child, nor makes a build directory, that is not in the lint's allowlist with its rule or ruling
tree_test(
    name = "graph_only",
    size = "small",
    cmd = ["python3", "tools/lint/graph_only.py"],
    data = [":tree"],
    git = True,
)

tree_test(
    name = "readability_spacing",
    size = "small",
    cmd = ["python3", "tools/lint/readability_spacing.py"],
    data = [
        "//tools/lint:tracked",
        ":tree_python",
        "//csrc/fsla:tracked",
    ],
)

#: NO LIBRARY KERNEL ISSUES A TENSOR STEP WIDER THAN 64 COLUMNS (CONSTITUTION R25): a `wgmma.mma_async` mnemonic of csrc/fsla with N over 64
tree_test(
    name = "wgmma_width",
    size = "small",
    cmd = ["python3", "tools/lint/wgmma_width.py"],
    data = [
        "//tools/lint:tracked",
        "//csrc/fsla:tracked",
    ],
)

tree_test(
    name = "portable_agent_files",
    size = "small",
    cmd = ["python3", "tools/lint/portable_claude.py"],
    data = [":tree"],
    git = True,
)

tree_test(
    name = "declarations",
    size = "small",
    cmd = ["python3", "-m", "fsla_devtools.mirror", "--check"],
    data = [":tree"],
    git = True,
)

tree_test(
    name = "ratchet_burst_tier",
    size = "small",
    cmd = ["python3", "tools/lint/ratchet.py", "burst_tier"],
    data = [":tree"],
    git = True,
)

tree_test(
    name = "ratchet_constant_parameters",
    size = "small",
    cmd = ["python3", "tools/lint/ratchet.py", "constant_parameters"],
    data = [":tree"],
    git = True,
)

tree_test(
    name = "ratchet_coverage",
    size = "small",
    cmd = ["python3", "tools/lint/ratchet.py", "coverage"],
    data = [":tree"],
    git = True,
)

tree_test(
    name = "ratchet_drift_guards",
    size = "small",
    cmd = ["python3", "tools/lint/ratchet.py", "drift_guards"],
    data = [":tree"],
    git = True,
)

tree_test(
    name = "ratchet_facts_in_template",
    size = "small",
    cmd = ["python3", "tools/lint/ratchet.py", "facts_in_template"],
    data = [":tree"],
    git = True,
)

tree_test(
    name = "ratchet_r9_enforcement",
    size = "small",
    cmd = ["python3", "tools/lint/ratchet.py", "r9_enforcement"],
    data = [":tree"],
    git = True,
)

#: EVERY RULE HAS A ROW (KERNEL_STANDARDS, the preamble): docs/rules.json names the mechanism of every rule of both documents,
#: and a row for every rule of the pinned checker (`@warpline`, the module the lab's check calls) carrying fsla's guidance on it
tree_test(
    name = "rules_table",
    size = "small",
    cmd = ["python3", "tools/lint/rules_table.py"],
    data = [":tree", "@warpline//:shared", "@warpline//:checker"],
)

tree_test(
    name = "ratchet_rules_owed",
    size = "small",
    cmd = ["python3", "tools/lint/ratchet.py", "rules_owed"],
    data = [":tree"],
    git = True,
)

tree_test(
    name = "ratchet_vulture",
    size = "small",
    cmd = ["python3", "tools/lint/ratchet.py", "vulture"],
    data = [":tree"],
    git = True,
)

tree_test(
    name = "ratchet_work_codes",
    size = "small",
    cmd = ["python3", "tools/lint/ratchet.py", "work_codes"],
    data = [":tree"],
    git = True,
)

checkout_test(
    name = "ratchet_baselines",
    size = "small",
    cmd = ["python3", "tools/lint/ratchet.py", "--grown"],
)

#: every doc reference pinned and read, under this tree's configuration -- see docs/testing.md (the doc references)
docrefs_test(
    name = "docrefs",
    size = "small",
    data = "@fsla_data//:root",
    exclude = ["docs/internals/DELETIONS.md"],
    lock = "docs/references.lock.json",
    mirrors = {
        "docs/internals/": "csrc/fsla/src/",
        "docs/internals/tools/": "tools/",
    },
    packages = {
        "bench": "measure",
        "fsla": "",
        "fsla_cu13": "",
        "measure": "",
        "tests": "",
        "tools": "",
    },
)

#: every agent lesson names a mechanism the tree holds (docs/internals/LEARNINGS.md)
checkout_test(
    name = "learnings",
    size = "small",
    cmd = ["python3", "tools/lint/learnings.py"],
)

#: a change to the devbox image the tree names carries a passing container check (`//:devbox_image` holds the name to the image)
checkout_test(
    name = "dev_container",
    size = "small",
    cmd = ["python3", "tools/dev.py", "container", "gate"],
)

#: the Bazel release this workspace names (`.bazelversion`) is the one fsla-devtools' shared pins are tested with
bazel_version_test(
    name = "bazelversion",
    size = "small",
    version = ".bazelversion",
)

test_suite(
    name = "lints",
    tests = [
        ":bazelversion",
        ":ruff",
        ":ruff_e3",
        ":lint_standards",
        ":graph_only",
        ":readability_spacing",
        ":wgmma_width",
        ":portable_agent_files",
        ":declarations",
        ":rules_table",
        ":ratchet_burst_tier",
        ":ratchet_constant_parameters",
        ":ratchet_coverage",
        ":ratchet_drift_guards",
        ":ratchet_facts_in_template",
        ":ratchet_r9_enforcement",
        ":ratchet_rules_owed",
        ":ratchet_vulture",
        ":ratchet_work_codes",
        "//csrc/fsla:lints",
        "//tools/lint:primitives_census",
    ],
)

test_suite(
    name = "commit_checks",
    tests = [
        ":dev_container",
        ":docrefs",
        ":learnings",
        ":ratchet_baselines",
        ":devbox_image",
        ":readme",
        ":support",
    ],
)

#: the gate's refusal of a narrowed contract: it fails, naming it, under any `--//:contract` but `full` (docs/build.md#narrowed)
full_contract_test(
    name = "full_contract",
    size = "small",
)

#: THE GATE: every check the graph holds, the lab's experiments' checked build among them (docs/build-graph.md#checks)
test_suite(
    name = "gate",
    tests = [
        ":commit_checks",
        ":full_contract",
        ":lints",
        "//measure/lab:checked",
        "//tests:lab",
        "//tools/lint:lint_fixtures",
    ],
)

#: THE TEST LANE: every tier (docs/testing.md#running-it)
test_suite(
    name = "lane",
    tests = ["//tests:lane"],
)
