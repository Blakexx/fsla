"""THE CONTRACT REGISTRY'S GRAPH TARGETS (docs/internals/hardware/registry.md): the registry's files, the `Facts` header generated from the schema and the
contract as the matchers' tools read it."""

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:defs.bzl", "tree_part")
load(":contract.bzl", "contract_output")

package(default_visibility = ["//visibility:public"])

#: this package's part of the tree the checks read
tree_part()

#: every file of the registry: the schema, the parts, the descriptors and the modules that expand them
filegroup(
    name = "registry",
    srcs = glob([
        "*.py",
        "*.json",
        "parts/**/*.json",
        "descriptors/*.json",
        "descriptors/dev/*.json",
        "descriptors/owed/*.json",
    ]),
)

#: the files the environment repository watches: the registry's module and the device parts, whose change is a new set of built architectures (`MODULE.bazel`)
exports_files([
    "__init__.py",
    "emit.py",
    "parts/device/hopper_sm90a.json",
    "registry.py",
])

genrule(
    name = "facts_header",
    srcs = [":registry"],
    outs = ["plan/facts.h"],
    cmd = "$(execpath @fsla_env//:python) $(execpath emit.py) --facts-header $@",
    tools = [
        "emit.py",
        "@fsla_env//:python",
    ],
)

#: `plan/facts.h`, the struct of every fact, generated from `schema.json`
cc_library(
    name = "facts",
    hdrs = [":facts_header"],
    includes = ["."],
)

genrule(
    name = "owed_header",
    srcs = [":registry"],
    outs = ["plan/owed.h"],
    cmd = "$(execpath @fsla_env//:python) $(execpath emit.py) --owed-header $@",
    tools = [
        "emit.py",
        "@fsla_env//:python",
    ],
)

#: `plan/owed.h`, the contexts the contract OWES (`descriptors/owed`) as a table the run time holds: `owed()`, a context each with the kernels it waits on
cc_library(
    name = "owed",
    hdrs = [":owed_header"],
    includes = ["."],
    deps = [":facts"],
)

#: THE CONTRACT: every context the build's contract holds, a line each (`registry.contexts_text`); `--//:contract` names a narrowed one
contract_output(
    name = "contexts",
    out = "contexts.txt",
    registry = ":registry",
    what = "contexts",
)

contract_output(
    name = "contract_header",
    out = "plan/contract.h",
    registry = ":registry",
    what = "contract-header",
)

#: `plan/contract.h`, the contract as a table the run time holds: `contract()`, a context each
cc_library(
    name = "contract",
    hdrs = [":contract_header"],
    includes = ["."],
    deps = [":facts"],
)
