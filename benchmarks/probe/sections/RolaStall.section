Identifier: "RolaStall"
DisplayName: "RoLA Stall Attribution Probe"
Description: "Repo-pinned scheduler/warp-state probe: where the issue slots go. Eligible-warp and issue-active rates (the no-eligible fraction is 100 minus issue-active), achieved occupancy, and the per-issue-active stall-reason ratios the latency campaign's verdicts are written in (barrier, long/short scoreboard, wait, throttles, sleeping). This file IS the metric list; a probe that needs different metrics adds a section beside it rather than a flag string in a shell script."
Order: 13

Sets { Identifier: "rola" }

Filter { CollectionFilter { CollectionScopes: CollectionScope_Launch } }

Header {
  Metrics { Label: "Duration"                    Name: "gpu__time_duration.sum" }
  Metrics { Label: "Eligible Warps Per Scheduler" Name: "smsp__warps_eligible.avg.per_cycle_active" }
  Metrics { Label: "Issue Active %"              Name: "smsp__issue_active.avg.pct_of_peak_sustained_active" }
  Metrics { Label: "Active Warps Per Scheduler"  Name: "smsp__warps_active.avg.per_cycle_active" }
  Metrics { Label: "Achieved Occupancy"          Name: "sm__warps_active.avg.pct_of_peak_sustained_active" }
}

Body {
  DisplayName: "RoLA Warp Stall Detail"
  SetDefault: true
  Items {
    Table {
      Label: "Warps Issue-Stalled Per Issue-Active (ratio)"
      Columns: 1
      Metrics { Label: "Stall Barrier"          Name: "smsp__average_warps_issue_stalled_barrier_per_issue_active.ratio" }
      Metrics { Label: "Stall Long Scoreboard"  Name: "smsp__average_warps_issue_stalled_long_scoreboard_per_issue_active.ratio" }
      Metrics { Label: "Stall Short Scoreboard" Name: "smsp__average_warps_issue_stalled_short_scoreboard_per_issue_active.ratio" }
      Metrics { Label: "Stall Wait"             Name: "smsp__average_warps_issue_stalled_wait_per_issue_active.ratio" }
      Metrics { Label: "Stall MIO Throttle"     Name: "smsp__average_warps_issue_stalled_mio_throttle_per_issue_active.ratio" }
      Metrics { Label: "Stall LG Throttle"      Name: "smsp__average_warps_issue_stalled_lg_throttle_per_issue_active.ratio" }
      Metrics { Label: "Stall Math Pipe Throttle" Name: "smsp__average_warps_issue_stalled_math_pipe_throttle_per_issue_active.ratio" }
      Metrics { Label: "Stall Not Selected"     Name: "smsp__average_warps_issue_stalled_not_selected_per_issue_active.ratio" }
      Metrics { Label: "Stall Sleeping"         Name: "smsp__average_warps_issue_stalled_sleeping_per_issue_active.ratio" }
      Metrics { Label: "Stall Selected"         Name: "smsp__average_warps_issue_stalled_selected_per_issue_active.ratio" }
    }
  }
}
