Identifier: "RolaMemOcc"
DisplayName: "RoLA Memory + Occupancy Probe"
Description: "Repo-pinned memory-and-occupancy probe: DRAM/L2/L1 traffic and hit rates, shared-memory bank conflicts, launch resource limits, achieved vs theoretical occupancy. This file IS the metric list; a probe that needs different metrics adds a section beside it rather than a flag string in a shell script."
Order: 12

Sets { Identifier: "rola" }

Filter { CollectionFilter { CollectionScopes: CollectionScope_Launch } }

Header {
  Metrics { Label: "Duration"                        Name: "gpu__time_duration.sum" }
  Metrics { Label: "DRAM Throughput"                 Name: "dram__throughput.avg.pct_of_peak_sustained_elapsed" }
  Metrics { Label: "L1/TEX Hit Rate"                 Name: "l1tex__t_sector_hit_rate.pct" }
  Metrics { Label: "L2 Hit Rate"                     Name: "lts__t_sector_hit_rate.pct" }
  Metrics { Label: "DRAM Bytes Read"                 Name: "dram__bytes_read.sum" }
  Metrics { Label: "DRAM Bytes Written"              Name: "dram__bytes_write.sum" }
  Metrics { Label: "Shared Load Bank Conflicts"      Name: "l1tex__data_bank_conflicts_pipe_lsu_mem_shared_op_ld.sum" }
  Metrics { Label: "Shared Store Bank Conflicts"     Name: "l1tex__data_bank_conflicts_pipe_lsu_mem_shared_op_st.sum" }
  Metrics { Label: "Global Load Sectors/Request"     Name: "l1tex__average_t_sectors_per_request_pipe_lsu_mem_global_op_ld.ratio" }
  Metrics { Label: "Registers Per Thread"            Name: "launch__registers_per_thread" }
  Metrics { Label: "Static Shared Memory Per Block"  Name: "launch__shared_mem_per_block_static" }
  Metrics { Label: "Dynamic Shared Memory Per Block" Name: "launch__shared_mem_per_block_dynamic" }
  Metrics { Label: "Block Limit Registers"           Name: "launch__occupancy_limit_registers" }
  Metrics { Label: "Block Limit Shared Mem"          Name: "launch__occupancy_limit_shared_mem" }
  Metrics { Label: "Block Limit Warps"               Name: "launch__occupancy_limit_warps" }
  Metrics { Label: "Theoretical Occupancy"           Name: "sm__maximum_warps_per_active_cycle_pct" }
  Metrics { Label: "Achieved Occupancy"              Name: "sm__warps_active.avg.pct_of_peak_sustained_active" }
  Metrics { Label: "Waves Per SM"                    Name: "launch__waves_per_multiprocessor" }
}

MetricDefinitions {
  MetricDefinitions {
    Name: "derived__rola_dram_bytes_total"
    Expression: "dram__bytes_read.sum + dram__bytes_write.sum"
  }
}

Body {
  DisplayName: "RoLA Memory Detail"
  SetDefault: true
  Items {
    Table {
      Label: "DRAM Traffic"
      Columns: 1
      Metrics { Label: "Total DRAM Bytes"           Name: "derived__rola_dram_bytes_total" }
      Metrics { Label: "L2 Sectors From L1 (load)"  Name: "lts__t_sectors_srcunit_tex_op_read.sum" }
      Metrics { Label: "L2 Sectors From L1 (store)" Name: "lts__t_sectors_srcunit_tex_op_write.sum" }
    }
  }
}
