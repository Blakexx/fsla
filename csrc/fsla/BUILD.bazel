"""THE EXTENSION'S UNITS: every hand-written unit under src/, each arm family's units for each built architecture
(`bazel/arms.bzl`), the registration unit, the generated headers and the device stamp (docs/build-graph.md#compile)."""

load("@fsla_env//:flags.bzl", "BUILT_ARCHS", "HOST_CXX_FLAGS", "NVCC_FLAGS")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//bazel:arms.bzl", "ARM_FAMILIES", "arm_family")
load("//bazel:cuda.bzl", "cuda_unit")
load("//bazel:defs.bzl", "census_test", "include_root", "fsla_headers", "tool_test", "tree_part", "tree_test", "unit_lint_test", "unit_sass", "with_contract")
load(":src/decode/arms.bzl", "DECODE_DECLARATIONS", "DECODE_KERNEL", "DECODE_KEY")
load(":src/entmax/arms.bzl", "ENTMAX_DECLARATIONS", "ENTMAX_FAMILIES", "ENTMAX_INCLUDER", "ENTMAX_KERNEL", "ENTMAX_KEYS", "ENTMAX_SPELLINGS")
load(":units.bzl", "RUNTIME_UNITS")

package(default_visibility = ["//visibility:public"])

#: every source the kernel list reads
filegroup(
    name = "sources",
    srcs = glob(["src/**"]),
)

#: THE ARCHITECTURES' HEADER, `common/hardware.cuh`, generated from the registry's device parts (`hardware/parts/device`) and checked in nowhere
#: (docs/internals/common/hardware.md); it does not depend on the build's parameters
genrule(
    name = "hardware_header",
    srcs = ["//hardware:registry"],
    outs = ["hardware/common/hardware.cuh"],
    cmd = "$(execpath @fsla_env//:python) $(execpath //hardware:emit.py) --arch-header $@",
    tools = [
        "//hardware:emit.py",
        "@fsla_env//:python",
    ],
)

cc_library(
    name = "hardware",
    hdrs = [":hardware_header"],
    includes = ["hardware"],
)

#: the repository's headers come first, so a repository header wins any name collision
include_root(
    name = "headers",
    hdrs = glob(["src/**/*.cuh"]),
    roots = ["src"],
    deps = [":hardware"],
)

#: each arm family's selection header and Python table (docs/build-graph.md#arms)
fsla_headers(
    name = "generated",
    arm_families = [":%s_%s" % (family, part) for family in ARM_FAMILIES for part in ("selection", "table")],
)

#: the device stamp: the digest of every file under src/ but its markdown, as `tools/csrc_stamp.py` computes it
genrule(
    name = "stamp_header",
    srcs = glob(
        ["src/**"],
        exclude = ["src/**/*.md"],
    ),
    outs = ["stamp/csrc_stamp.inc"],
    cmd = "$(execpath @fsla_env//:python) $(execpath //tools:csrc_stamp.py) --src csrc/fsla/src --out $@",
    tools = [
        "//tools:csrc_stamp.py",
        "@fsla_env//:python",
    ],
)

cc_library(
    name = "stamp",
    hdrs = [":stamp_header"],
    includes = ["stamp"],
)

_DEPS = [
    ":headers",
    ":plan_headers",
    "//csrc/third_party:cutlass",
    ":generated",
    "@fsla_env//:python_headers",
    "@fsla_env//:torch_headers",
]

#: the host C++ compiler's identity, an input of every compile: never a header, which a compile prunes when it does not
#: read it (docs/build-graph.md#rules)
_HOST_CC = "@host_cc//:identity.txt"

#: the one unit that reads the device stamp, the digest of every source: only it depends on the stamp, so an edit to
#: one source recompiles that source's unit and this one, not every unit
_STAMP_UNIT = "src/common/build_stamp.cu"

#: the runtime's units
cuda_unit(
    name = "runtime",
    srcs = RUNTIME_UNITS,
    copts = NVCC_FLAGS,
    host_cc = _HOST_CC,
    deps = _DEPS,
)

cuda_unit(
    name = "units",
    srcs = [unit for unit in glob(["src/**/*.cu"]) if unit != _STAMP_UNIT and unit not in RUNTIME_UNITS],
    copts = NVCC_FLAGS,
    host_cc = _HOST_CC,
    deps = _DEPS,
)

cuda_unit(
    name = "stamp_unit",
    srcs = [_STAMP_UNIT],
    copts = NVCC_FLAGS,
    host_cc = _HOST_CC,
    deps = _DEPS + [":stamp"],
)

#: EACH UNIT'S SASS AS TEXT, by the graph's disassembler: `bazel build //csrc/fsla:<unit>_sass`, a unit by its source's name (`decode_sass`,
#: `entmax_sass`), for a SASS diff that needs no disassembler typed by hand
[unit_sass(
    name = "%s_sass" % unit.rsplit("/", 1)[-1].removesuffix(".cu"),
    library = "//:library",
    unit = unit.rsplit("/", 1)[-1].removesuffix(".cu"),
) for unit in glob(["src/**/*.cu"])]

#: THE PLANNER'S HEADERS: the rule language, the launch functions and the host half of the planner (`common/plan/`), with each kernel's `Facts` class, contract and owed contexts generated from the registry (`//hardware:<kernel>_facts`, `//hardware:<kernel>_contract`)
cc_library(
    name = "plan_headers",
    hdrs = glob(["src/common/plan/*.h"]),
    includes = ["src/common"],
    deps = [
        "//hardware:mask_prepare_contract",
        "//hardware:mask_prepare_facts",
        "//hardware:prefill_contract",
        "//hardware:prefill_facts",
    ] + [
        "//hardware:%s_%s" % (family, part)
        for family in ARM_FAMILIES
        for part in ("contract", "facts")
    ],
)

#: THE ARM GENERATOR, one for every family: the family's matcher evaluated over the whole of its contract. It writes the rows file `arm_family` instantiates and
#: the selection record, and FAILS the build, naming the context, when a contract context reaches no arm (docs/internals/common/plan/arms_gen.md)
cc_binary(
    name = "arms_gen",
    srcs = ["src/common/plan/arms_gen.cpp"],
    additional_compiler_inputs = [_HOST_CC],
    copts = ["-std=c++20"],
    deps = [":plan_headers"],
)

#: THE PLANNER ON A SYNTHETIC ENVIRONMENT: the library's own planner and decode's launch function on device facts the caller gives (the tests' tool)
cc_binary(
    name = "plan_tool",
    srcs = ["src/common/plan/plan_tool.cpp"],
    additional_compiler_inputs = [_HOST_CC],
    copts = ["-std=c++20"],
    deps = [":plan_headers"],
)

#: EACH FAMILY'S PLAN: its contract's contexts evaluated by the generator, the family's rows file and selection record
[genrule(
    name = "%s_plan" % family,
    srcs = ["//hardware:%s_contexts" % family],
    outs = [
        "%s_plan/%s_arm_rows.json" % (family, family),
        "%s_plan/%s_selection_record.txt" % (family, family),
    ],
    cmd = "$(execpath :arms_gen) --contexts $(execpath //hardware:%s_contexts) --out-dir $(RULEDIR)/%s_plan" % (family, family),
    tools = [":arms_gen"],
) for family in ARM_FAMILIES]

#: THE NARROWED CONTRACT'S PLAN AND PLANNER (tests/unit/test_narrowed_contract.py): the same tool and planner built under a development contract
with_contract(
    name = "decode_plan_narrowed",
    contract = "decode_d32_l2",
    target = ":decode_plan",
)

with_contract(
    name = "plan_tool_narrowed",
    contract = "decode_d32_l2",
    target = ":plan_tool",
)

arm_family(
    name = "decode",
    arms_file = ":decode_plan/decode_arm_rows.json",
    built_archs = BUILT_ARCHS,
    declarations = DECODE_DECLARATIONS,
    includer = "csrc/fsla/src/decode/decode.cu",
    kernel = DECODE_KERNEL,
    key = DECODE_KEY,
)

#: THE PRODUCER'S SOLVES' FAMILIES, one for each kernel (`src/entmax/arms.bzl`): the arms the kernel's contract reaches, each held by the SASS gate to be carried once
[arm_family(
    name = family,
    arms_file = ":%s_plan/%s_arm_rows.json" % (family, family),
    built_archs = BUILT_ARCHS,
    declarations = ENTMAX_DECLARATIONS[family],
    includer = ENTMAX_INCLUDER[family],
    kernel = ENTMAX_KERNEL[family],
    key = ENTMAX_KEYS[family],
    spellings = ENTMAX_SPELLINGS,
) for family in ENTMAX_FAMILIES]

cc_library(
    name = "registration",
    srcs = ["fsla_api.cpp"],
    additional_compiler_inputs = [_HOST_CC],
    alwayslink = True,
    copts = HOST_CXX_FLAGS,
    deps = _DEPS + ["//bazel:cuda_headers"],
)

#: EVERY HEADER COMPILES ALONE (tools/header_selfcheck.py, docs/testing.md#headers): one unit per header, containing the header
#: twice and nothing else, compiled by the graph's CUDA rule with the library's own flags and include roots, so a unit is cached
#: by the headers it read and an edit recompiles only the units that read it. The units are named by the header they hold.
_SELFCHECK_HEADERS = glob(["src/**/*.cuh"])

_SELFCHECK_UNITS = {
    header: "selfcheck/%s_selfcheck.cu" % header.removeprefix("src/").removesuffix(".cuh").replace("/", "__")
    for header in _SELFCHECK_HEADERS
}

genrule(
    name = "header_selfcheck_sources",
    outs = _SELFCHECK_UNITS.values(),
    cmd = " && ".join([
        "printf '#include \"%s\"\\n#include \"%s\"\\n' > $(RULEDIR)/%s" % (header.removeprefix("src/"), header.removeprefix("src/"), unit)
        for header, unit in _SELFCHECK_UNITS.items()
    ]),
)

cuda_unit(
    name = "header_selfcheck_units",
    srcs = [":header_selfcheck_sources"],
    archs = ["compute_%s:sm_%s" % (arch, arch) for arch in BUILT_ARCHS],
    copts = NVCC_FLAGS,
    host_cc = _HOST_CC,
    #: the headers that reach torch (`common/torch_seam.cuh`) need the toolkit's libraries' headers the registration unit gets
    deps = _DEPS + ["//bazel:cuda_headers"],
)

#: the check: every header has its unit, and the units compiled (a failed unit fails the build this test depends on)
tool_test(
    name = "header_selfcheck",
    size = "small",
    args_ = [
        "--headers",
        "$(rootpaths :header_files)",
        "--objects",
        "$(rootpaths :header_selfcheck_units)",
    ],
    data = [
        ":header_files",
        ":header_selfcheck_units",
    ],
    tool = "//tools:header_selfcheck.py",
)

filegroup(
    name = "header_files",
    srcs = _SELFCHECK_HEADERS,
)

#: this package's part of the tree the checks read
tree_part()

#: THIS PACKAGE'S LINTS (docs/build-graph.md#checks): its sources' format and standards rules, its template kernels
#: against the build's instantiations, and each unit's own compile linted for each built architecture

tree_test(
    name = "clang_format",
    size = "small",
    cmd = [
        "/bin/bash",
        "-c",
        "find -L csrc/fsla -type f \\( -name '*.cu' -o -name '*.cuh' -o -name '*.cpp' -o -name '*.h' -o -name '*.hpp' \\) " +
        "-print0 | sort -z | xargs -0 clang-format --style=file --dry-run --Werror",
    ],
    data = [
        "//:.clang-format",
        ":tracked",
    ],
)

tree_test(
    name = "ast_grep",
    size = "small",
    cmd = ["python3", "tools/lint/ast_grep_gate.py"],
    data = [
        "//tools/lint:tracked",
        "//:sgconfig.yml",
        ":tracked",
        "//csrc/third_party:tracked",
    ],
)

census_test(
    name = "unused_instantiations",
    size = "small",
    census = "//:census",
    data = ["//:tree"],
    script = "lint/unused_instantiations.py",
)

unit_lint_test(
    name = "clang_tidy_device",
    size = "small",
    lint = "device",
    units = ["//:library"],
)

unit_lint_test(
    name = "clang_tidy_host",
    size = "small",
    lint = "host",
    units = ["//:library"],
)

unit_lint_test(
    name = "host_warnings",
    size = "small",
    lint = "warnings",
    units = ["//:library"],
)

test_suite(
    name = "lints",
    tests = [
        ":ast_grep",
        ":clang_format",
        ":clang_tidy_device",
        ":clang_tidy_host",
        ":header_selfcheck",
        ":host_warnings",
        ":unused_instantiations",
    ],
)
