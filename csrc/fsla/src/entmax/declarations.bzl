    return "fsla::entmax::detail::%s<denseref::arch::BuildTag<denseref::arch::Build{(int)900}>, (int)%d, (int)%d%s, %s, %s>" % (
        row[0], row[1], row[2], flag, _TYPES[row[4]], _TYPES[row[5]])

ENTMAX_DECLARATIONS = [
    declaration(kernel_pattern(_kernel(row)), rule, row[6 + i], _PREDATES + _FOUND[rule], "sm_90a")
    for row in _FINDINGS
    for i, rule in enumerate(["load_in_trip", "loop_convergence"])
    if row[6 + i]
]
