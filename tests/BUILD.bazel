"""THE TEST TIERS (docs/testing.md#running-it): each tier one target, as pytest runs it (bazel/defs.bzl's
`pytest_tier`). Each test is in one tier: the CPU tier is tests/unit's rows that launch nothing, run with no device
visible; a device tier runs alone. Every tier takes the library: collecting a tier reaches the plugin."""

load("//bazel:defs.bzl", "pytest_tier", "tree_part")

pytest_tier(
    name = "cpu",
    size = "large",
    data = [
        "//:library",
        "//:tree",
    ],
    marks = "not cuda",
    shard_count = 4,
    tests = ["tests/unit"],
)

pytest_tier(
    name = "unit_cuda",
    size = "large",
    data = [
        "//:library",
        "//:tree",
    ],
    device = True,
    marks = "cuda",
    tests = ["tests/unit"],
)

pytest_tier(
    name = "oracle",
    size = "large",
    data = [
        "//:library",
        "//:tree",
    ],
    device = True,
    tests = ["tests/oracle"],
)

pytest_tier(
    name = "integration",
    size = "large",
    data = [
        "//:library",
        "//:tree",
    ],
    device = True,
    tests = ["tests/integration"],
)

test_suite(
    name = "lane",
    tests = [
        ":cpu",
        ":integration",
        ":oracle",
        ":unit_cuda",
    ],
)

#: this package's part of the tree the checks read
tree_part()
