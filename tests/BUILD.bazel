"""THE TEST TIERS (docs/testing.md#running-it): each tier one target, as pytest runs it (bazel/defs.bzl's
`pytest_tier`). Each test is in one tier: the CPU tier is tests/unit's rows that launch nothing, run with no device
visible; a device tier runs alone. Every tier takes the library: collecting a tier reaches the plugin."""

load("@fsla_env//:flags.bzl", "BUILT_ARCHS", "NVCC_FLAGS")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//bazel:arms.bzl", "ARM_FAMILIES", "arm_family", "arm_rows", "arm_selection")
load("//bazel:cuda.bzl", "cuda_unit")
load("//bazel:defs.bzl", "device_lane", "pytest_tier", "tree_part")
load(":unit/fixtures/fixture_arms.bzl", "FIXTURE_ROWS")

#: THE LAB'S UNIT TESTS: the lab's, the dev config's and the measurement declaration's (`declare.py`), which `:lab` runs and `:cpu` leaves out
LAB_TESTS = [
    "unit/test_dev_config*.py",
    "unit/test_declare.py",
    "unit/test_lab_*.py",
]

#: THE PROBES THE UNIT TESTS READ, compiled by the graph (docs/testing.md#probes): each test takes what it needs as data and
#: runs no compiler. The device probes are built for the build's architectures (`BUILT_ARCHS`), the CUDA rule's flags
#: being the probes' own (`-O3`, relaxed constexpr)
_PROBE_ARCHS = ["compute_%s:sm_%s" % (arch, arch) for arch in BUILT_ARCHS]
_PROBE_COPTS = ["-O3", "--expt-relaxed-constexpr"]
_HOST_CC = "@host_cc//:identity.txt"

#: the two SASS probes are read, never run, and built for the build's architectures as the others are
[cuda_unit(
    name = name + "_probe",
    srcs = ["unit/fixtures/%s_probe.cu" % name],
    archs = _PROBE_ARCHS,
    copts = _PROBE_COPTS,
    host_cc = _HOST_CC,
    deps = ["//csrc/fsla:headers"],
) for name in ["sass_gate", "life_ranges"]]

cuda_unit(
    name = "structure_switch_unit",
    srcs = ["unit/fixtures/structure_switch_probe.cu"],
    archs = _PROBE_ARCHS,
    copts = _PROBE_COPTS + ["-std=c++17"],
    host_cc = _HOST_CC,
    deps = ["//csrc/fsla:headers"],
)

cc_binary(
    name = "structure_switch_probe",
    deps = [
        ":structure_switch_unit",
        "@cuda_tools//:cuda_runtime_static",
    ],
)

#: the fixture's key and the domain of each field, the decode family's shape
_FIXTURE_KEY = ["d_v", "levels", "decay"]
_FIXTURE_DOMAINS = {
    "d_v": [32, 64],
    "levels": [1, 2, 3, 4],
    "decay": [0, 1],
}

#: THE FIXTURE ARM FAMILY (tests/unit/fixtures/fixture_arms.bzl): the macro of bazel/arms.bzl on a family that is not a shipped one. Its three rows make a unit each for each built architecture, its selection header names the arms
#: of every row (a real family's rows are the arms its contract reaches), and its table is the rows (tests/unit/test_arm_family.py reads all three)

cc_library(
    name = "fixture_headers",
    hdrs = [
        ":fixture_selection",
        "unit/fixtures/fixture_arm.cuh",
    ],
    includes = [
        "generated",
        "unit/fixtures",
    ],
)

arm_family(
    name = "fixture",
    arms = FIXTURE_ROWS,
    built_archs = BUILT_ARCHS,
    domains = _FIXTURE_DOMAINS,
    includer = "the fixture's arm units",
    key = _FIXTURE_KEY,
    unit = {
        "arm_header": "fixture_arm.cuh",
        "copts": NVCC_FLAGS,
        "define": "FSLA_FIXTURE_ARM_DEFINE",
        "deps": [":fixture_headers"],
        "host_cc": _HOST_CC,
    },
)

#: the host arm switch's probe over a synthetic selection header: one binary each for a build carrying two of the fixture's
#: three arms and one carrying none (c10's `TORCH_CHECK` is the refusal; the test hands its library path)
arm_rows(
    name = "arm_switch_rows",
    arms = json.encode(FIXTURE_ROWS),
    key = _FIXTURE_KEY,
)

[arm_selection(
    name = "arm_switch_%s_selection" % variant,
    dir = "arm_switch_%s" % variant,
    family = "fixture",
    includer = "the arm switch's probe",
    rows = ":arm_switch_rows",
    selected = selected,
) for variant, selected in {"built": ["0", "2"], "empty": []}.items()]

[cc_library(
    name = "arm_switch_%s_header" % variant,
    hdrs = [":arm_switch_%s_selection" % variant],
    includes = ["arm_switch_%s" % variant],
) for variant in ["built", "empty"]]

[cc_binary(
    name = "arm_switch_probe_%s" % variant,
    srcs = [
        "unit/fixtures/arm_switch_probe.cpp",
        "@fsla_env//:torch_libraries",
    ],
    additional_compiler_inputs = [_HOST_CC],
    copts = ["-std=c++17", "-O0"],
    deps = [
        ":arm_switch_%s_header" % variant,
        "//csrc/fsla:headers",
        "@fsla_env//:torch_headers",
    ],
) for variant in ["built", "empty"]]

pytest_tier(
    name = "cpu",
    size = "large",
    data = [
        "//:library",
        "//:tree",
        "@warpline//:shared",
        "@warpline//:checker",
        "@warpline//:recorder",
        ":arm_switch_probe_built",
        ":arm_switch_probe_empty",
        "//csrc/fsla:arms_gen",
    ] + ["//csrc/fsla:%s_plan" % family for family in ARM_FAMILIES] + [
        "//csrc/fsla:plan_tool",
        "//csrc/fsla:decode_plan_narrowed",
        "//csrc/fsla:plan_tool_narrowed",
        ":fixture_arm_set",
        ":fixture_selection",
        ":fixture_table",
        ":life_ranges_probe",
        ":sass_gate_probe",
    ],
    marks = "not cuda",
    #: the pinned data (MODULE.bazel's `environment.data`): the H100 lab records the floor model and the rates read
    repos = {
        "@fsla_data//:records": "FSLA_DATA",
        #: fsla-devtools' shared pins (the toolkit pin tests/unit/test_cuda_toolkit_pin.py reads)
        "@fsla_devtools//pins:cuda_toolkit_pin.json": "FSLA_DEVTOOLS",
    },
    shard_count = 4,
    tests = ["tests/" + f for f in glob(
        ["unit/test_*.py"],
        exclude = LAB_TESTS,
    )],
)

#: THE LAB'S UNIT TESTS, which the gate runs (`//:gate`): the lab's, the dev config's and the measurement declaration's rows of the CPU tier, on their
#: own, with the checker from `@warpline` (the module this tree pins) on their path, never a machine's. The lane's
#: `:cpu` leaves them out, so each test is in one tier
pytest_tier(
    name = "lab",
    size = "large",
    data = [
        "//:library",
        "//:tree",
        "@warpline//:shared",
        "@warpline//:checker",
        "@warpline//:recorder",
    ],
    marks = "not cuda",
    repos = {"@fsla_data//:records": "FSLA_DATA"},
    tests = ["tests/" + f for f in glob(LAB_TESTS)],
)

pytest_tier(
    name = "unit_cuda",
    size = "large",
    data = [
        "//:library",
        "//:tree",
        "@warpline//:shared",
        "@warpline//:checker",
        "@warpline//:recorder",
        ":structure_switch_probe",
    ],
    device = True,
    marks = "cuda",
    tests = ["tests/unit"],
)

pytest_tier(
    name = "oracle",
    size = "large",
    data = [
        "//:library",
        "//:tree",
    ],
    device = True,
    tests = ["tests/oracle"],
)

pytest_tier(
    name = "integration",
    size = "large",
    data = [
        "//:library",
        "//:tree",
    ],
    device = True,
    tests = ["tests/integration"],
)

test_suite(
    name = "lane",
    tests = [
        ":cpu",
        ":integration",
        ":lab",
        ":oracle",
        ":unit_cuda",
    ],
)

#: THE SANITIZER LANE (docs/testing.md#the-sanitizer-lane): compute-sanitizer, the toolkit's own, over one oracle cell a
#: family; run when a component lands, before a census and on a schedule, never by a commit's suite
device_lane(
    name = "sanitizer",
    timeout = "eternal",
    cmd = [
        "python3",
        "tools/sanitize_oracle.py",
        "--sanitizer",
        "{compute-sanitizer}",
    ],
    data = [
        "//:library",
        "//:tree",
    ],
    tools = {"@cuda_tools//:compute_sanitizer": "compute-sanitizer"},
)

#: this package's part of the tree the checks read
tree_part()
