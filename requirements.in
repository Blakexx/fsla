# ONE Python lock file's source: the environment's requirements (MODULE.bazel's `environment.python(lock = ...)`, the dev
# container's too). Compile it with `bazel run //:lock_update`: the pinned uv resolves this file, with hashes, into
# requirements.lock (`uv pip compile requirements.in --python-version 3.11 --generate-hashes
# --extra-index-url https://download.pytorch.org/whl/cu130 --index-strategy unsafe-best-match`). The extra index is
# required because a plain PyPI resolve of `torch` fetches the CPU-only wheel, and the extension is built against the CUDA one.
# Everything the repo imports is listed (`pyproject.toml`'s `dependencies`, and a grep of `fsla/`, `tests/`,
# `tools/`, `measure/` for top-level imports); a line without `==` floats to the newest release at the next compile.

# --- pyproject.toml's runtime dependencies ---
# torch for the cu13 toolchain's CUDA major, from its `torch_index` (tools/toolchains/cu13.json).
torch==2.14.0+cu130
einops==0.8.2

# --- measure/'s plotting and result tables ---
matplotlib
pandas==3.0.3

# --- the oracle/routing gate's reference (`entmax`, pinned: fsla/routing/entmax/PIN.json) and xdist ---
entmax==1.3
pytest-xdist==3.8.0

# --- the lints' tools, at the versions CI pins, so a lint runs from this environment and never from a
# tool the host happens to have ---
ruff==0.14.10
vulture==2.16
# the ast-grep gate's reader of its rule files (tools/lint/ast_grep_gate.py)
pyyaml==6.0.3
clang-format==19.1.7
ast-grep-cli==0.45.2

# --- the devbox's developer tools: a developer's commands the tree does not run, which the dev image and every
# checkout's venv carry (docs/setup.md) ---
py-spy==0.4.3
#: the editor's language server, at the pinned clang-tidy's LLVM major (fsla-devtools' pins/clang_tidy_pin.json)
clangd==22.1.1

# --- shared pytest core ---
pytest==9.1.1

# --- pytest's timeout and the oracle's drawn cells ---
pytest-timeout==2.4.0
hypothesis==6.165.10

# --- torch.utils.cpp_extension's imports (ratify's compile path, the header self-check) ---
setuptools>=61
packaging
