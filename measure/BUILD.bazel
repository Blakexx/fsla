"""THE TIMING ENTRIES AND SESSIONS, THE INSTRUMENTS AND THE RECORDS' STORES (docs/measurement.md): each entry one
executor of `executors.py` on central cells, in this tree's bundle; each session one `bazel run` that measures its
entries interleaved and stores the record; each store one `bazel run` that records a build output, or an instrument on
the device it runs first.

    bazel run //measure:session_entmax                       # measure and store (at @fsla//measure:session_entmax)
    bazel run //measure:session_entmax -- --no-store         # measure, keep session.json, store nothing
    bazel run //measure:store_static_manifest                # the static manifests, recorded at their store's label
    bazel run //measure:store_oracle_tier                    # the oracle tier on the device, recorded at its store's label
"""

load("//bazel:defs.bzl", "instrument", "interleaved_timing", "results_store", "timing_entry", "tree_part")

#: the Python a timing entry's executor imports, beside the library its bundle carries: this package, the `fsla` package,
#: the contract registry `hardware` and the arm families' one reader with the registry it reads
filegroup(
    name = "bundle",
    srcs = glob([
        "*.py",
        "cells/*.py",
    ]) + [
        "//:package",
        "//bazel:arms.bzl",
        "//hardware:registry",
        "//tools:arm_families.py",
    ],
)

#: THE PRODUCER'S SOLVE on the pinned layer cell (the mid-size entmax layer at B 2, H 8, hidden 512): the one layer arm
#: whose kernels this line builds
timing_entry(
    name = "entmax_solve_layer-alt-entmax1.5-64x64-T2048",
    cells = ["@fsla_cells//:layer-alt-entmax1.5-64x64-T2048"],
    executor = "measure.executors:timed",
    params = {"arm": "entmax_solve"},
)

#: the SM clock as this binary reads it, which proves a locked host's clock before and after a session
timing_entry(
    name = "clock",
    executor = "measure.executors:read_clock",
    kind = "clock",
)

#: `unlocked`: the rented card's container declares no clock lock; a host that declares one still locks and proves it
interleaved_timing(
    name = "session_entmax",
    claim = "unlocked",
    clock = ":clock",
    entries = [":entmax_solve_layer-alt-entmax1.5-64x64-T2048"],
)

#: THE STATIC MANIFESTS' RECORD: each built architecture's (`//:static_manifest`), keyed by the library it reads and the
#: checker that read it
results_store(
    name = "store_static_manifest",
    src = "//:static_manifest",
    inputs = [
        "//:library",
        "@warpline//:checker",
    ],
)

#: THE ORACLE TIER ON THE DEVICE (`oracle_tier.py`): the battery's counts, its failed cases and every comparison's
#: margins, keyed by the library, the tree and the devices
instrument(
    name = "oracle_tier",
    data = [
        "//:library",
        "//:tree",
    ],
    device = True,
    tool = "oracle_tier.py",
)

results_store(
    name = "store_oracle_tier",
    src = ":oracle_tier",
)

#: this package's part of the tree the checks read
tree_part()
