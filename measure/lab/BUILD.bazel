"""THE LAB'S EXPERIMENTS: one target each (bazel/lab.bzl, docs/internals/tools/lab.md#graph), built by the graph's CUDA rule for sm_90a,
read by the graph's disassemblers, checked by the lab's checks as the target's validation. `bazel build //measure/lab:<name>`, or
`bazel run //tools:lab -- pack <name> --arch sm_90a --into DIR`, which builds it with its checks and copies its outputs."""

load("//bazel:defs.bzl", "include_root", "tree_part")
load("//bazel:lab.bzl", "lab_checked_test", "lab_experiment")

package(default_visibility = ["//visibility:public"])

#: this package's part of the tree the checks read
tree_part()

#: `lab.cuh`, which every experiment includes (with the harness's own kernel headers, `//csrc/fsla:harness_headers`, and warpline's `@warpline//:stamp`)
include_root(
    name = "lab_headers",
    hdrs = ["lab.cuh"],
    roots = ["."],
)

#: the experiments that include another experiment's source (`#include "carry_window.cu"`): the sources they name
_INCLUDES = {
    "call_pair": ["experiments/carry_window.cu", "experiments/intra_window.cu"],
}

#: the experiments that include a kernel's own headers: the header sets they name
_DEPS = {
    "mask_prepare_time": ["//csrc/fsla:headers"],
}

[lab_experiment(
    name = src[len("experiments/"):-len(".cu")],
    src = src,
    includes = _INCLUDES.get(src[len("experiments/"):-len(".cu")], []),
    deps = _DEPS.get(src[len("experiments/"):-len(".cu")], []),
) for src in glob(["experiments/*.cu"])]

#: THE GATE'S LAB BUILD (`//:gate`): every experiment's checked build -- its compile, its facts and its LabCheck -- so a commit that
#: breaks one is refused; a cached build costs nothing, a cold one the experiments' compiles (docs/build-graph.md#checks)
lab_checked_test(
    name = "checked",
    experiments = [":" + src[len("experiments/"):-len(".cu")] for src in glob(["experiments/*.cu"])],
)
