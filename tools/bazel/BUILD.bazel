"""THE GRAPH'S OWN DECLARATIONS: the build's platform, and the toolchain's smoke target."""

load("@rules_cuda//cuda:defs.bzl", "cuda_library")

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

#: the hermetic toolkit compiles and links a kernel: the workspace's first proof
cuda_library(
    name = "toolchain_smoke",
    srcs = ["toolchain_smoke.cu"],
)
