"""THE TREE'S TOOLS AS THE GRAPH'S INPUTS: the pins and records the graph's repositories read, and the generators its
actions run."""

package(default_visibility = ["//visibility:public"])

exports_files(glob([
    "*.py",
    "*.json",
    "toolchains/*.json",
    "manifests/*.json",
    "manifests/*/*.json",
]))

filegroup(
    name = "manifests_cu13",
    srcs = glob(["manifests/cu13/*.json"]),
)

filegroup(
    name = "toolchain_records",
    srcs = glob(["toolchains/*.json"]),
)

filegroup(
    name = "budgets",
    srcs = glob(["budgets/**"]),
)

#: the tools' Python and the lints', which the gates import
filegroup(
    name = "python_sources",
    srcs = glob([
        "*.py",
        "lint/*.py",
    ]),
)
