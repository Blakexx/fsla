tree_test(
    name = "ratchet_r9_enforcement",
    size = "small",
    cmd = ["python3", "tools/lint/ratchet.py", "r9_enforcement"],
    data = ["//:tree"],
    git = True,
)

tree_test(
    name = "ratchet_vulture",
    size = "small",
    cmd = ["python3", "tools/lint/ratchet.py", "vulture"],
    data = ["//:tree"],
    git = True,
)

tree_test(
    name = "ratchet_work_codes",
    size = "small",
    cmd = ["python3", "tools/lint/ratchet.py", "work_codes"],
    data = ["//:tree"],
    git = True,
)

#: THE UNIT LINTS, each unit's own compile linted for each ratified architecture (docs/build-graph.md#checks)
unit_lint_test(
    name = "clang_tidy_device",
    size = "small",
    lint = "device",
    units = ["//:library"],
)

unit_lint_test(
    name = "clang_tidy_host",
    size = "small",
    lint = "host",
    units = ["//:library"],
)

unit_lint_test(
    name = "host_warnings",
    size = "small",
    lint = "warnings",
    units = ["//:library"],
)

#: THE DERIVATION'S GOLDEN HARNESS, rendered from the declared cases and built as the extension's units are: ratify runs
#: it in place of its own compile (docs/internals/tools/ratify.md#graph). It names the smallest tabulated architecture,
#: as ratify's compile does: the derivation is the same on every tabulated card
genrule(
    name = "derivation_harness_source",
    srcs = ["manifests/derivation_cases.json"],
    outs = ["derivation/derivation_harness.cu"],
    cmd = "$(execpath @rola_env//:python) $(execpath derivation.py) --cases $(execpath manifests/derivation_cases.json) --out $@",
    tools = [
        "derivation.py",
        "@rola_env//:python",
    ],
)

cuda_unit(
    name = "derivation_unit",
    srcs = [":derivation_harness_source"],
    archs = ["compute_80:sm_80"],
    copts = [
        "-std=c++20",
        "-O0",
    ],
    host_cc = "@host_cc//:identity.txt",
    deps = ["//csrc/rola:headers"],
)

cc_binary(
    name = "derivation_harness",
    deps = [
        ":derivation_unit",
        "@cuda//:cuda_runtime_static",
    ],
)

#: THE LINTS' FIXTURES (docs/internals/tools/lint.md#fixtures): each lint fires on its own fixture's must-fire case and
#: stays quiet on the rest -- the Python lints' own self-tests, and the unit lints' fixtures linted as units

tree_test(
    name = "ast_grep_fixtures",
    size = "small",
    cmd = ["python3", "tools/lint/ast_grep_gate.py", "--test-fixtures"],
    data = [
        ":lint",
        "//:sgconfig.yml",
    ],
)

tree_test(
    name = "constant_parameters_fixtures",
    size = "small",
    cmd = ["python3", "tools/lint/constant_parameters.py", "--test-fixtures"],
    #: its self-test runs the real scan too: no fixture leaks into it
    data = [
        ":lint",
        "//:tree_python",
    ],
)

tree_test(
    name = "drift_guards_fixtures",
    size = "small",
    cmd = ["python3", "tools/lint/drift_guards.py", "--test-fixtures"],
    data = [":lint"],
)

tree_test(
    name = "r9_enforcement_fixtures",
    size = "small",
    cmd = ["python3", "tools/lint/r9_enforcement.py", "--test-fixtures"],
    data = [":lint"],
)

tree_test(
    name = "readability_spacing_fixtures",
    size = "small",
    cmd = ["python3", "tools/lint/readability_spacing.py", "--test-fixtures"],
    data = [":lint"],
)

tree_test(
    name = "unused_instantiations_fixtures",
    size = "small",
    cmd = ["python3", "tools/lint/unused_instantiations.py", "--test-fixtures"],
    data = [":lint"],
)

tree_test(
    name = "vulture_fixtures",
    size = "small",
    cmd = ["tools/lint/run_vulture.sh", "--test-fixtures"],
    data = [":lint"],
)

#: compiled as the extension's units are (bazel/cuda.bzl), so the lint reads the same kind of compile
cuda_unit(
    name = "fixture_device_unit",
    srcs = ["lint/fixtures/device_lint_unused_param.cu"],
    host_cc = "@host_cc//:identity.txt",
)

cc_library(
    name = "fixture_host_unit",
    srcs = ["lint/fixtures/host_warnings_unused_param.cpp"],
    additional_compiler_inputs = ["@host_cc//:identity.txt"],
)

unit_lint_test(
    name = "clang_tidy_device_fixtures",
    size = "small",
    expect = [
        "'unused_param' is unused \\[misc-unused-parameters\\]",
        "Value stored to 'twice' is never read \\[clang-analyzer-deadcode.DeadStores\\]",
    ],
    lint = "device",
    units = [":fixture_device_unit"],
)

unit_lint_test(
    name = "host_warnings_fixtures",
    size = "small",
    expect = ["unused parameter .unused_param. \\[-Wunused-parameter\\]"],
    lint = "warnings",
    units = [":fixture_host_unit"],
)

test_suite(
    name = "lint_fixtures",
    tests = [
        ":ast_grep_fixtures",
        ":clang_tidy_device_fixtures",
        ":constant_parameters_fixtures",
        ":drift_guards_fixtures",
        ":host_warnings_fixtures",
        ":r9_enforcement_fixtures",
        ":readability_spacing_fixtures",
        ":unused_instantiations_fixtures",
        ":vulture_fixtures",
    ],
)

#: THE CHECKS OF THE COMMIT, run in the checkout: what git knows
checkout_test(
    name = "ratchet_baselines",
    size = "small",
    cmd = ["python3", "tools/lint/ratchet.py", "--grown"],
)

checkout_test(
    name = "docrefs",
    size = "small",
    cmd = ["python3", "tools/docrefs.py"],
)

checkout_test(
    name = "dev_container",
    size = "small",
    cmd = ["python3", "tools/dev.py", "container", "gate"],
)

test_suite(
    name = "lints",
    tests = [
        ":ast_grep",
        ":clang_format",
        ":clang_tidy_device",
        ":clang_tidy_host",
        ":host_warnings",
        ":lint_standards",
        ":mirror_declarations",
        ":portable_agent_files",
        ":readability_spacing",
        ":ruff",
        ":ruff_e3",
        ":unused_instantiations",
    ] + [":ratchet_" + r for r in ["burst_tier", "constant_parameters", "coverage", "drift_guards", "r9_enforcement", "vulture", "work_codes"]],
)

test_suite(
    name = "commit_checks",
    tests = [
        ":dev_container",
        ":docrefs",
        ":ratchet_baselines",
    ],
)
