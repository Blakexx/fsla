# THE CONTENT CHECKS, BEFORE A PUSH: every commit the push adds to the remote (the pushed ref's commits not
# already on a ref of that remote) is read patch by patch by fsla_devtools.tripwire (`bazel run //:tripwire -- --range`),
# so a line a public repository must not carry -- the full history is public -- never leaves the machine. docs/build-graph.md#checks
set -euo pipefail
zero="0000000000000000000000000000000000000000"
status=0
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    revisions=("$local_sha" --not "--remotes=$1")
  else
    revisions=("$remote_sha..$local_sha")
  fi
  bazel run --noshow_progress --ui_event_filters=-info --lockfile_mode=error //:tripwire -- --range "${revisions[@]}" || status=1
done
exit "$status"
