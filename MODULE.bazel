"""THE BUILD GRAPH'S MODULE: its rule sets and the hermetic CUDA toolkit it declares (docs/build-graph.md)."""

module(name = "rola")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_python", version = "2.4.6")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_cuda", version = "0.3.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_distroless", version = "0.9.4")
bazel_dep(name = "tar.bzl", version = "0.7.0")

#: THE CUDA TOOLKIT, HERMETIC: NVIDIA's redistributable components at the toolchain pin's version
#: (tools/toolchains/cu13.json: release 13.0, nvcc V13.0.48), fetched once into the repository cache.
cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.redist_json(
    name = "cuda_13_0_0",
    #: the compiler and what it reads, nothing more (rules_cuda's short names): NVIDIA's whole redistributable set is
    #: 4.7 GB, these ~75 MB
    components = [
        "cccl",
        "crt",
        "cudart",
        "culibos",
        "nvcc",
        "nvvm",
    ],
    #: redistrib_13.0.0.json's own digest: the component versions it names (nvcc 13.0.48, cuobjdump 13.0.39) are the pin
    sha256 = "fe6a86b54450d03ae709123a52717870c49046d65d45303ce585c7aa8a83a217",
    version = "13.0.0",
)
cuda.toolkit(name = "cuda")
use_repo(cuda, "cuda")

#: THE GRAPH'S ENVIRONMENT: the Python environment built from requirements.lock into the shared store, the pinned
#: linker and the host C++ compiler's identity (bazel/environment.bzl)
environment = use_extension("//bazel:environment.bzl", "environment")
#: the toolkit's disassemblers (the binary gates' readers), from the manifest the toolkit above is read by, by the same digest
environment.cuda_tools(
    manifest = "https://developer.download.nvidia.com/compute/cuda/redist/redistrib_13.0.0.json",
    sha256 = "fe6a86b54450d03ae709123a52717870c49046d65d45303ce585c7aa8a83a217",
)
use_repo(environment, "bazelisk", "clang_tidy", "cuda_tools", "host_cc", "host_gpu", "mold", "rola_env", "rola_tree", "uv")

#: THE DEVBOX IMAGE (docs/setup.md#the-devbox): a thin wrapper around the bootstrap. Its base carries what a host
#: supplies itself before the graph -- Ubuntu 22.04 with git, gcc, python3 and curl -- a Docker Official Image by digest
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "devbox_base",
    digest = "sha256:12415f057b11a5d155b7262cfdc9e6cb4127a3cf1f5a447e063e41b9c176b70e",
    image = "index.docker.io/library/buildpack-deps",
    platforms = ["linux/amd64"],
)
use_repo(oci, "devbox_base", "devbox_base_linux_amd64")

#: its OS packages, pinned: resolved against Ubuntu's archive on the base image's day, every .deb by digest
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64"],
    components = [
        "main",
        "universe",
    ],
    suites = [
        "jammy",
        "jammy-updates",
        "jammy-security",
    ],
    types = ["deb"],
    uris = ["https://snapshot.ubuntu.com/ubuntu/20261027T000000Z"],
)
apt.install(
    dependency_set = "devbox",
    packages = [
        "clang-tools-14",
        "fd-find",
        "graphviz",
        "jq",
        "less",
        "sqlite3",
        "universal-ctags",
        "vim",
    ],
    suites = [
        "jammy",
        "jammy-updates",
        "jammy-security",
    ],
)
use_repo(apt, "devbox")
