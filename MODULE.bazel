"""THE BUILD GRAPH'S MODULE: its rule sets and the pinned CUDA toolkit it declares (docs/build-graph.md)."""

module(name = "fsla")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_python", version = "2.4.6")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_distroless", version = "0.9.4")
bazel_dep(name = "tar.bzl", version = "0.7.0")

#: THE HOST C++ TOOLCHAIN (docs/build-graph.md#environment): GCC 12.5.0, its binutils and its own sysroot (glibc 2.26,
#: below the 2.28 torch's wheels are built to; libstdc++ up to GLIBCXX_3.4.30, which Ubuntu 22.04's runtime carries), one
#: release by its digest, registered as the C++ toolchain every rules_cc action takes and handed to every CUDA compile as
#: nvcc's host compiler (`-ccbin`, bazel/cuda.bzl) -- the machine's compiler is never detected (.bazelrc). Inside the CUDA
#: toolkit's supported host compilers (GCC 6.x-16.x for 13.5); `//tests:host_abi` reads what it built
bazel_dep(name = "gcc_toolchain", version = "0.13.0")

gcc_toolchains = use_extension("@gcc_toolchain//toolchain:module_extensions.bzl", "gcc_toolchains")
gcc_toolchains.toolchain(
    name = "gcc_toolchain_x86_64",
    enable_fortran = False,
    #: the C++ runtime every link takes, as the auto-configured toolchain linked it: the pinned libstdc++, by its soname
    extra_ldflags = ["-lstdc++"],
    gcc_version = "12.5.0",
    gcc_versions = '{"12.5.0": {"x86_64": {"url": "https://github.com/f0rmiga/gcc-builds/releases/download/18082025/gcc-toolchain-12.5.0-x86_64.tar.xz", "sha256": "51076e175839b434bb2dc0006c0096916df585e8c44666d35b0e3ce821d535db"}}}',
    target_arch = "x86_64",
)
use_repo(gcc_toolchains, "gcc_toolchain_x86_64")

register_toolchains("@gcc_toolchain_x86_64//:all")

#: THE GRAPH'S SHARED MACHINERY, fsla-devtools' module: its environment extension and generic rules, at the public
#: commit this tree is tested with -- the one pin of fsla-devtools (tools/bootstrap.py reads it for a machine with no
#: checkout). A machine with the checkout builds against it instead: the front door overrides this pin with it.
bazel_dep(name = "fsla_devtools", version = "0.1.0")
git_override(
    module_name = "fsla_devtools",
    commit = "0db2f5ef6a61fa24968b9f075d592c106eae947f",
    remote = "https://github.com/Blakexx/fsla-devtools.git",
)

#: WARPLINE'S MODULE: the header `warpline/stamp.cuh` the lab's `lab.cuh` includes (`@warpline//:stamp`, a dependency of each
#: experiment's compile in bazel/lab.bzl), the checker (`warpline.checker`, `@warpline//:checker`) the experiments'
#: validation action runs for every hazard a rule computes -- at the public commit this tree is tested with, the one pin
bazel_dep(name = "warpline", version = "0.1.0")
git_override(
    module_name = "warpline",
    commit = "9d9c3685275d6c8dcd9356dc575e62cec002ee50",
    remote = "https://github.com/Blakexx/warpline.git",
)

#: THE GRAPH'S ENVIRONMENT (fsla-devtools' environment extension, docs/build-graph.md#environment): the pinned uv; the
#: Python environment built from requirements.lock into the shared store, fsla-devtools from its module's source, the
#: graph's compile flags and facts from bazel/flags.py; the pinned linker and clang-tidy; the
#: devices' identity; the checkout's tracked files; the pinned CUDA toolkit and cuRAND's headers; the central cells
environment = use_extension("@fsla_devtools//bazel:environment.bzl", "environment")
environment.pinned(
    name = "uv",
    build_file = "//bazel:uv.BUILD",
    #: uv and the Python it installs, fsla-devtools' pin: every FSLA workspace's environment is built by the same
    pin = "@fsla_devtools//pins:uv_pin.json",
)
environment.python(
    name = "fsla_env",
    build_file = "//bazel:env.BUILD",
    index_from = "//tools:toolchains/cu13.json",
    lock = "//:requirements.lock",
    post = "//bazel:flags.py",
    post_args = ["//tools:toolchains/cu13.json"],
    uv = "@uv//:uv",
    uv_pin = "@fsla_devtools//pins:uv_pin.json",
    #: the flags' sources, the registry module and the device parts (the directory, watched as a tree: any part added or changed is a new set of built architectures), which state the architectures that are the build's defaults
    watch = [
        "//hardware:__init__.py",
        "//hardware:registry.py",
        "//tools:build_flags.py",
    ],
    watch_trees = ["//hardware:parts/device"],
)
environment.pinned(
    name = "mold",
    build_file = "//bazel:mold.BUILD",
    pin = "@fsla_devtools//pins:mold_pin.json",
)
environment.pinned(
    name = "clang_tidy",
    build_file = "//bazel:clang_tidy.BUILD",
    pin = "@fsla_devtools//pins:clang_tidy_pin.json",
)
environment.host_gpu(name = "host_gpu")
environment.tree(name = "fsla_tree")
environment.cuda_toolkit(
    name = "cuda_tools",
    #: cuRAND's headers, the graph's alone: its libraries are not the graph's
    beside = {"libcurand": "curand"},
    build_file = "//bazel:cuda_tools.BUILD",
    delete = ["curand/lib"],
    pin = "@fsla_devtools//pins:cuda_toolkit_pin.json",
)
#: THE DATA, at ONE commit of the data repository (fsla-results): every record a doc cites (`data:records/fsla/measure/lab/...`) and a tool
#: reads (the lab's pages, the floor model, the rates) is the file at this pin, fixed content by the archive's digest
environment.data(
    name = "fsla_data",
    commit = "9964ff2e29d63a12e6d2d15c533d75f50f8f8de9",
    remote = "https://github.com/Blakexx/fsla-results",
    sha256 = "c8238e6a5fb5690fd6c5828ca2e92403f3fc13d8b93df780bc5408eb9f5defde",
)
#: every central cell's description as a target (`@fsla_cells//:<cell>`), which a timing entry takes (docs/measurement.md)
environment.cells(
    name = "fsla_cells",
    uv = "@uv//:uv",
    uv_pin = "@fsla_devtools//pins:uv_pin.json",
)
#: the doc references' tool (fsla-devtools' `fsla_devtools.docrefs`), which `//:docrefs` runs
environment.docrefs(name = "docrefs")
use_repo(environment, "clang_tidy", "cuda_tools", "docrefs", "fsla_cells", "fsla_data", "host_gpu", "mold", "fsla_env", "fsla_tree", "uv")

#: THE DEVBOX IMAGE (docs/setup.md#the-devbox-image): a thin wrapper around the bootstrap. Its base carries what a host
#: supplies itself before the graph -- Ubuntu 22.04 with git, gcc, python3 and curl -- a Docker Official Image by digest
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "devbox_base",
    digest = "sha256:12415f057b11a5d155b7262cfdc9e6cb4127a3cf1f5a447e063e41b9c176b70e",
    image = "index.docker.io/library/buildpack-deps",
    platforms = ["linux/amd64"],
)
use_repo(oci, "devbox_base", "devbox_base_linux_amd64")

#: its OS packages, pinned: resolved against Ubuntu's archive on the base image's day, every .deb by digest
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64"],
    components = [
        "main",
        "universe",
    ],
    suites = [
        "jammy",
        "jammy-updates",
        "jammy-security",
    ],
    types = ["deb"],
    uris = ["https://snapshot.ubuntu.com/ubuntu/20261027T000000Z"],
)
apt.install(
    dependency_set = "devbox",
    packages = [
        "clang-tools-14",
        "fd-find",
        "graphviz",
        "jq",
        "less",
        "sqlite3",
        "universal-ctags",
        "vim",
    ],
    suites = [
        "jammy",
        "jammy-updates",
        "jammy-security",
    ],
)
use_repo(apt, "devbox")
